# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). When set, the site loads
# GA on the public frontend only. Leave it blank to disable analytics entirely.
# Recommended: set this ONLY in the production environment, so local dev and preview
# deploys don't send traffic to your analytics.
NEXT_PUBLIC_GA_ID=

# SMTP for outgoing form notifications (the "Emails" panel on each Form).
# Send through a real mailbox on the domain — no third-party service needed.
# Leave SMTP_HOST empty and Payload logs emails to the console instead;
# submissions are always stored under Form Submissions regardless.
#
# Find the host from the domain's MX record. Port 587 = STARTTLS, 465 = implicit TLS.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=mailbox@yourdomain.com
SMTP_PASS=YOUR_MAILBOX_PASSWORD
#
# IMPORTANT: escape any `$` in the password as `\$`. Next.js runs .env values through
# dotenv-expand, so an unescaped `$FOO` is read as a variable reference and silently
# dropped — you get an auth failure with no obvious cause.

# EMAIL_FROM_ADDRESS must be the SAME mailbox as SMTP_USER, or SPF fails and the mail
# is rejected or spam-filed. CONTACT_TO is where the notification lands.
EMAIL_FROM_NAME=Smile360 Chicago
EMAIL_FROM_ADDRESS=mailbox@yourdomain.com
CONTACT_TO=mailbox@yourdomain.com
